-- 3. VISTAS 
-- 3.1 Curso actual de cada estudiante = curso de su asistencia más reciente (en el esquema, la relación estudiante-curso vive en asistencia)
create or replace view vw_estudiante_curso_actual as
select e.idestudiante,
       e.numerodocumentoEst,
       e.nombres,
       e.apellidos,
       e.activo,
       e.idacudiente,
       a.idcurso,
       a.fecha as fecha_ultimo_registro
from estudiante e
join asistencia a on a.idestudiante = e.idestudiante
where a.idasistencia = (select a2.idasistencia
                        from asistencia a2
                        where a2.idestudiante = e.idestudiante
                        order by a2.fecha desc, a2.fecha_hora_registro desc
                        limit 1);
 
-- 3.2 Cursos clasificados por nivel y jornada (RQF-013, 014)
create or replace view vw_cursos_clasificados as
select c.idcurso,
       c.nombre       as curso,
       c.grado,
       c.aniolectivo,
       c.activo,
       n.idnivel,
       n.nombre       as nivel,
       j.idjornada,
       j.nombre       as jornada,
       (select count(*) from vw_estudiante_curso_actual ec
        where ec.idcurso = c.idcurso and ec.activo = true) as estudiantes_activos
from curso c
join jornada j on c.nombre like concat('% - ', j.nombre)
join nivel   n on n.nombre = if(c.grado <= 5, 'Primaria', 'Bachillerato');
 
-- 3.3 Bloques clasificados por nivel y jornada (RQF-017, 018)
create or replace view vw_bloques_clasificados as
select b.idbloque,
       b.nombre       as bloque,
       b.numero,
       b.horainicioBlo,
       b.horafinBlo,
       n.idnivel,
       n.nombre       as nivel,
       j.idjornada,
       j.nombre       as jornada
from bloque b
join nivel   n on b.nombre like concat('% - ', n.nombre, ' - %')
join jornada j on b.nombre like concat('% - ', j.nombre);
 
-- 3.4 Estudiantes activos por curso con datos del acudiente (RQF-016)
create or replace view vw_estudiantes_curso as
select ec.idestudiante,
       ec.numerodocumentoEst,
       ec.nombres,
       ec.apellidos,
       cc.idcurso,
       cc.curso,
       cc.nivel,
       cc.jornada,
       a.idacudiente,
       concat(a.nombres, ' ', a.apellidos) as acudiente,
       a.parentesco,
       a.telefono as telefono_acudiente
from vw_estudiante_curso_actual ec
join vw_cursos_clasificados cc on cc.idcurso = ec.idcurso
join acudiente a on a.idacudiente = ec.idacudiente
where ec.activo = true;
 
-- 3.5 Acudientes con sus estudiantes (HU10)
create or replace view vw_acudiente_estudiantes as
select a.idacudiente,
       a.tipodocumentoAcu,
       a.numerodocumentoAcu,
       concat(a.nombres, ' ', a.apellidos) as acudiente,
       a.parentesco,
       a.telefono,
       a.correo,
       a.direccion,
       e.idestudiante,
       concat(e.nombres, ' ', e.apellidos) as estudiante,
       e.activo as estudiante_activo
from acudiente a
left join estudiante e on e.idacudiente = a.idacudiente;
 

