    in p_idcoordinador int,
    in p_idusuario int,
    in p_nuevo_rol varchar(20)
)
begin
    declare v_acceso boolean;

    call sp_rqf008_controlar_acceso(p_idcoordinador, 'COORDINADOR', v_acceso);
    if v_acceso = false then
        signal sqlstate '45000' set message_text = 'Error: No tiene permisos de coordinador para asignar roles.';
    end if;

    if not exists (select 1 from usuario where idusuario = p_idusuario) then
        signal sqlstate '45000' set message_text = 'Error: El usuario al que intenta asignar rol no existe.';
    end if;

    if p_nuevo_rol not in ('COORDINADOR', 'MAESTRO') then
        signal sqlstate '45000' set message_text = 'Error: El rol debe ser COORDINADOR o MAESTRO.';
    end if;

    update usuario 
    set rol = p_nuevo_rol 
    where idusuario = p_idusuario;
end //
