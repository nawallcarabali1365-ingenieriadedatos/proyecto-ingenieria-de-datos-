-- RQF 001 & 002: Crear usuario y registrar datos personales / de acceso
drop procedure if exists sp_rqf001_crear_usuario 
delimiter //
create procedure sp_rqf001_crear_usuario(
    in p_numerodocumentoUsu varchar(20),
    in p_nombres varchar(60),
    in p_apellidos varchar(60),
    in p_correo varchar(100),
    in p_contrasena varchar(255)
)
begin
    if trim(p_numerodocumentoUsu) = '' or trim(p_nombres) = '' or trim(p_apellidos) = '' or trim(p_correo) = '' or trim(p_contrasena) = '' then
        signal sqlstate '45000' set message_text = 'Error: Todos los campos obligatorios deben estar diligenciados.';
    end if;

    if p_correo not regexp '^[^@[:space:]]+@[^@[:space:]]+\\.[^@[:space:]]+$' then
        signal sqlstate '45000' set message_text = 'Error: El formato del correo electrónico no es válido.';
    end if;

    call sp_rqf004_validar_unicos(p_numerodocumentoUsu, p_correo);

    insert into usuario (numerodocumentoUsu, nombres, apellidos, correo, contrasena, rol, activo)
    values (p_numerodocumentoUsu, p_nombres, p_apellidos, p_correo, sha2(p_contrasena, 256), 'MAESTRO', true);

    select 'Usuario registrado exitosamente' as mensaje;
end //
delimiter ;


-- RQF 004: Validar datos únicos

delimiter //
drop procedure if exists sp_rqf004_validar_unicos //
create procedure sp_rqf004_validar_unicos(
    in p_numerodocumentoUsu varchar(20),
    in p_correo varchar(100)
)
begin
    if exists (select 1 from usuario where numerodocumentoUsu = p_numerodocumentoUsu) then
        signal sqlstate '45000' set message_text = 'Error: El número de documento ya se encuentra registrado.';
    end if;

    if exists (select 1 from usuario where correo = p_correo) then
        signal sqlstate '45000' set message_text = 'Error: El correo electrónico ya se encuentra registrado.';
    end if;
end //
delimiter ;


-- RQF 008: Controlar acceso por rol 
delimiter //
drop procedure if exists sp_rqf008_controlar_acceso //
create procedure sp_rqf008_controlar_acceso(
    in p_idusuario int,
    in p_rol_requerido varchar(20),
    out p_tiene_acceso boolean
)
begin
    declare v_rol_actual varchar(20);
    declare v_activo boolean;

    select rol, activo into v_rol_actual, v_activo 
    from usuario 
    where idusuario = p_idusuario;

    if v_activo = true and v_rol_actual = p_rol_requerido then
        set p_tiene_acceso = true;
    else
        set p_tiene_acceso = false;
    end if;
end //
delimiter ;


-- RQF 003: Asignar rol inicial

delimiter //
