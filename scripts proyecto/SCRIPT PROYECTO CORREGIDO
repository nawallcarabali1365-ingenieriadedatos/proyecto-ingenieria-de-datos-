-- RQF-022 / RQF-024 Asignar y cambiar curso  No hay columna donde guardar la asignación: el curso del estudiante se registra en asistencia.idcurso. Este procedimiento CONSULTA la
-- trayectoria del estudiante: en qué cursos tiene registros y cuál es el actual. Así se verifica que un cambio de curso conserva el historial.
drop procedure if exists sp_rqf024_consultar_cursos_estudiante;
delimiter //
create procedure sp_rqf024_consultar_cursos_estudiante(in p_idestudiante int)
begin
    if not exists (select 1 from estudiante where idestudiante = p_idestudiante) then
        signal sqlstate '45000' set message_text = 'El estudiante no existe';
    end if;
 
    select * from vw_estudiante_curso_actual where idestudiante = p_idestudiante;
 
    select c.curso, c.nivel, c.jornada,
           min(a.fecha) as desde, max(a.fecha) as hasta, count(*) as registros
    from asistencia a
    join vw_cursos_clasificados c on c.idcurso = a.idcurso
    where a.idestudiante = p_idestudiante
    group by c.idcurso, c.curso, c.nivel, c.jornada
    order by desde;
end //
 
