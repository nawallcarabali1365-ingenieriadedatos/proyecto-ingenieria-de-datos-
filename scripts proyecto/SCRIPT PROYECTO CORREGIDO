for each row
begin
    declare v_ini  time;
    declare v_fin  time;
    declare v_cant int;
 
    if not exists (select 1 from jornada where new.nombre like concat('% - ', nombre))
       or not exists (select 1 from nivel where new.nombre like concat('% - ', nombre, ' - %')) then
