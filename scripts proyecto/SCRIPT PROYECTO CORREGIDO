-- RQF-017 Configurar bloques horarios  El nombre se arma con el formato de los datos: 'Bloque N - Nivel - Jornada'. Como bloque.nombre es UNIQUE, el número queda único por nivel y jornada. Horario y tope de bloques: trg_bloque_bi.
drop procedure if exists sp_rqf017_configurar_bloque;
delimiter //
create procedure sp_rqf017_configurar_bloque(
    in p_idusuario int,
    in p_numero    int,
    in p_inicio    time,
    in p_fin       time,
    in p_idnivel   int,
    in p_idjornada int)
begin
    declare v_nombre varchar(50);
 
    call sp_rqf008_controlar_acceso(p_idusuario, 'COORDINADOR', @acceso);
    if not @acceso then
        signal sqlstate '45000' set message_text = 'Solo un coordinador activo puede configurar bloques';
    end if;
    if p_numero is null or p_inicio is null or p_fin is null then
        signal sqlstate '45000' set message_text = 'Todos los campos del bloque son obligatorios';
    end if;
    if not exists (select 1 from nivel where idnivel = p_idnivel) then
        signal sqlstate '45000' set message_text = 'El nivel no existe';
    end if;
    if not exists (select 1 from jornada where idjornada = p_idjornada) then
        signal sqlstate '45000' set message_text = 'La jornada no existe';
