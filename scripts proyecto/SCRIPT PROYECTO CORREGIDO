drop procedure if exists sp_rqf009_configurar_jornada;
delimiter //
create procedure sp_rqf009_configurar_jornada(
    in p_idusuario int, in p_nombre varchar(20), in p_inicio time, in p_fin time)
begin
    call sp_rqf008_controlar_acceso(p_idusuario, 'COORDINADOR', @acceso);
