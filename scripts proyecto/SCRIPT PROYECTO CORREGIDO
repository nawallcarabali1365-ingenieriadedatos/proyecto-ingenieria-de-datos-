    if exists (select 1 from bloque where nombre = v_nombre) then
        signal sqlstate '45000' set message_text = 'Ya existe un bloque con ese número para el nivel y la jornada';
    end if;
 
    insert into bloque (nombre, numero, horainicioBlo, horafinBlo)
