    in p_idusuario   int,
    in p_numero      varchar(10),
    in p_grado       int,
    in p_aniolectivo year,
    in p_idjornada   int)
begin
    declare v_nombre varchar(20);
 
    call sp_rqf008_controlar_acceso(p_idusuario, 'COORDINADOR', @acceso);
