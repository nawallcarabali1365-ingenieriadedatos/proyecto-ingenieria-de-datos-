    end if;
 
    select cantidadbloques into v_cant
    from nivel where new.nombre like concat('% - ', nombre, ' - %') limit 1;
 
    if new.numero > v_cant then
        signal sqlstate '45000'
            set message_text = 'El número del bloque supera la cantidad de bloques del nivel';
