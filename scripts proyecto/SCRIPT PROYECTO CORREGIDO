-- 5. CONSULTAS

-- 5.1 Jornadas con cantidad de cursos y bloques
select j.nombre as jornada, j.horainicioJor, j.horafinJor,
       (select count(*) from vw_cursos_clasificados c where c.idjornada = j.idjornada) as cursos,
       (select count(*) from vw_bloques_clasificados b where b.idjornada = j.idjornada) as bloques
from jornada j;
 
-- 5.2  Bloques configurados vs. bloques esperados por nivel y jornada
select n.nombre as nivel, j.nombre as jornada, n.cantidadbloques as esperados,
       count(b.idbloque) as configurados
from nivel n
cross join jornada j
left join vw_bloques_clasificados b on b.idnivel = n.idnivel and b.idjornada = j.idjornada
group by n.idnivel, n.nombre, j.idjornada, j.nombre, n.cantidadbloques;
 
-- 5.3  Cursos de bachillerato en la jornada tarde
select curso, grado, estudiantes_activos
from vw_cursos_clasificados
where nivel = 'Bachillerato' and jornada = 'Tarde' and activo = true
order by grado, curso;
 
-- 5.4  Cursos sin estudiantes activos
select curso, nivel, jornada
from vw_cursos_clasificados
where estudiantes_activos = 0 and activo = true;
 
-- 5.5  Horario de bloques de primaria en la jornada mañana
select numero, bloque, horainicioBlo, horafinBlo
from vw_bloques_clasificados
where nivel = 'Primaria' and jornada = 'Mañana'
order by numero;
 
-- 5.6  Acudientes con más de un estudiante a cargo
select numerodocumentoAcu, acudiente, count(idestudiante) as estudiantes
from vw_acudiente_estudiantes
group by idacudiente, numerodocumentoAcu, acudiente
having count(idestudiante) > 1;
 
-- 5.7  Estudiantes registrados que aún no tienen curso
--     (no tienen ningún registro de asistencia)
select e.numerodocumentoEst, concat(e.nombres, ' ', e.apellidos) as estudiante
from estudiante e
where not exists (select 1 from asistencia a where a.idestudiante = e.idestudiante);
 
-- 5.8 Estudiantes inactivos y cuántos registros de asistencia conservan
select ec.numerodocumentoEst, concat(ec.nombres, ' ', ec.apellidos) as estudiante,
       c.curso as ultimo_curso,
       (select count(*) from asistencia a where a.idestudiante = ec.idestudiante) as registros
from vw_estudiante_curso_actual ec
join vw_cursos_clasificados c on c.idcurso = ec.idcurso
where ec.activo = false;
     
